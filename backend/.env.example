DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SOYLE_ENV=production
SOYLE_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-bytes
SOYLE_ALLOWED_ORIGINS=http://localhost:3000
SOYLE_ALLOWED_ORIGIN_REGEX=
SOYLE_COOKIE_SAMESITE=lax
SOYLE_SEED_DEMO_DATA=false
SOYLE_ADMIN_USERNAME=admin
SOYLE_ADMIN_PASSWORD=replace-with-a-unique-admin-password
SOYLE_ADMIN_NAME=Администратор Söyle
# Server-side only. Never expose this value through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
SOYLE_OPENAI_MODEL=gpt-4o-mini
SOYLE_AI_REQUESTS_PER_HOUR=30
