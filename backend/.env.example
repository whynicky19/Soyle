DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SOYLE_ENV=production
SOYLE_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-bytes
SOYLE_ALLOWED_ORIGINS=http://localhost:3000
SOYLE_ALLOWED_ORIGIN_REGEX=
SOYLE_COOKIE_SAMESITE=lax
SOYLE_SEED_DEMO_DATA=false
SOYLE_ADMIN_USERNAME=admin
SOYLE_ADMIN_PASSWORD=replace-with-a-unique-admin-password
SOYLE_ADMIN_NAME=Администратор Söyle

# MVP operator facts: leave empty until established; shown on /privacy.
SOYLE_OPERATOR_NAME=
SOYLE_OPERATOR_COUNTRY=
SOYLE_PRIVACY_CONTACT_EMAIL=
SOYLE_HOSTING_LOCATION=
SOYLE_HISTORY_RETENTION_POLICY=
SOYLE_BACKUP_RETENTION_POLICY=
SOYLE_DELETION_REQUEST_POLICY=

# Server-only Azure Speech. Never use NEXT_PUBLIC_* for these values.
AZURE_TTS_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
