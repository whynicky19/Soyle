      "file": "43c9dc5661d4de13b58e72412772ab232c4883b4651deec07d616c353dcc9f46.wav"
    },
    {
      "text": "Дай взрослому ложку",
      "file": "175aa37d9a448aad663003b788cf94ccf321265e8abc2ff241fd624e5d886855.wav"
    },
    {
