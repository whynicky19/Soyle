      "file": "1aa3782e2b974d6b03b1216e5e06fa529cd1f64242c27622e01cd9b66cf25ef4.wav"
    },
    {
      "text": "Брат",
      "file": "5d66d036b93054e6ce1c0d3e46c5f8e7583619b036a87833037111bb46691102.wav"
    },
    {
      "text": "Брюки",
      "file": "44749641180126a1a62558a738e09a17e6c56399df85a4a6d065d6545d6e84c6.wav"
    },
    {
      "text": "Варежки",
      "file": "253615b9ec69baecb030ea371e1b6c548563ca1739de494b8c06b64a3e81805d.wav"
    },
    {
      "text": "Взрослый помог выразить просьбу. Мама идёт к полке.",
      "file": "011c1bdf188ef6c01f55f431a487eae3265897103bc0223bad65e7e9474d6a65.wav"
    },
    {
      "text": "Вижу кота",
      "file": "7e2b677eb753735ce01c4b5cbfbf75765a588bfdaaea8f024fbaa063591213ca.wav"
    },
    {
      "text": "Вижу маму",
      "file": "14550017b39f99a0603ae4536a6d50f49896641283cad630ad6d072ce67848bb.wav"
    },
    {
      "text": "Вижу папу",
      "file": "cece6d8b2e6b443822357533c0495556e8286cd3dc52c718d95c832ca61962e7.wav"
    },
    {
      "text": "Вода",
      "file": "cb591d31e1ef0b53e97b50039ec7a7abccad135d633939aec57d382323235e4c.wav"
    },
    {
      "text": "Воздушный змей",
      "file": "20533530b9f4817c4f9b350e4a464ff67f822dcef0d2207667ddf9db0298a34b.wav"
    },
    {
      "text": "Возьми мяч",
      "file": "f6e1f7982a9483ac98c4258a466bdd3646a2850cd99d22d6a0b7c629d5bb55a9.wav"
    },
    {
      "text": "Возьми чашку",
      "file": "d9af02337787d4ecc7ba8fcb1db3853539a3b1a11bee6b4d24562bd8c637072a.wav"
    },
    {
      "text": "Вот он! Мишка сидит высоко.",
      "file": "fb3e138c1dd1aabef92bcc83977851c06a52095a18b627964c07db73d681aa78.wav"
    },
    {
      "text": "Вчера",
      "file": "5362e348449490012ed374b4817565deedf5dfbb5a3c4bff545b8e3435c097cf.wav"
    },
    {
      "text": "Где?",
      "file": "887b7807718119d28cfd157d397738bc10b283865a8e533a0d70337b38583389.wav"
    },
    {
      "text": "Глаза",
      "file": "f9580f82106b52b29325110979532c6e464c6aa05b0b278b29380c1730896da5.wav"
    },
    {
      "text": "Голова",
      "file": "89e7aabc1a41a84c1969beb3d78b237cf0850893e1de592f5c615b0f26e89edc.wav"
    },
    {
      "text": "Да",
      "file": "2e4507d2a16f5e6dca109dcc6058ebfb20f32b0b65e9ce21e9eb699dc39d1ed0.wav"
    },
    {
      "text": "Дай взрослому банан",
      "file": "b27fd388ea44be521709be24f07f6855faf92d3d08f898c32fa6d0c5237ba546.wav"
    },
    {
