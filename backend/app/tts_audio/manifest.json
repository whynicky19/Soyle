      "file": "fc663b04059fbdd1762acda0da111796d1c1eb926dd61bf56c3b6414642c02c5.wav"
    },
    {
      "text": "Книга в корзине.",
      "file": "727a116a5638cebc8eea3c695364138038c688104fbfae09479653f9deb77bfc.wav"
    },
    {
      "text": "Книга в коробке.",
      "file": "f3988ae7cb4050b106a1ee0293bb646c9d586e19fbad110784b6571c80a57084.wav"
    },
